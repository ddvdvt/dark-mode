{
  "name": "dark-mode",
  "version": "1.1.0",
  "private": true,
  "description": "Тёмный режим: быстрая тёмная тема для любых сайтов",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:e2e": "node e2e/smoke.mjs && node e2e/sites.mjs",
    "perf": "node e2e/perf.mjs",
    "icons": "node scripts/make-icons.mjs",
    "zip": "node scripts/pack.mjs",
    "store:images": "node scripts/store-images.mjs",
    "test:sites": "node e2e/sites.mjs",
    "zip:firefox": "node scripts/firefox.mjs",
    "lint:firefox": "node scripts/firefox.mjs && web-ext lint --source-dir dist/firefox",
    "test:e2e:firefox": "node e2e/firefox.mjs && node e2e/firefox-sites.mjs",
    "test:sites:firefox": "node e2e/firefox-sites.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "puppeteer-core": "^25.16.0",
    "web-ext": "^10.8.0"
  }
}
